# ========================================
# CONFIGURACIÓN DEL SERVIDOR BYJ ERP
# ========================================

# Base de datos MySQL (Core)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kmp_db
DB_USER=your_username
DB_PASSWORD=your_password

# Base de datos MySQL (Document Management)
DOCUMENT_DB_HOST=localhost
DOCUMENT_DB_PORT=3306
DOCUMENT_DB_NAME=documentos_db
DOCUMENT_DB_USER=your_username
DOCUMENT_DB_PASSWORD=your_password

# Configuración del Servidor
SERVER_PORT=8080

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth Redirect URI
# Usar localhost solo si se usa desktop en la misma máquina
# Para Android usar URL público
OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback
# OAUTH_REDIRECT_URI=http://your-domain.com:8080/auth/callback

# ========================================
# CONFIGURACIÓN DE EMAIL
# ========================================

# Habilitar/deshabilitar envío de emails
EMAIL_ENABLED=true

# Configuración SMTP (Gmail)
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME=Sistema ERP BYJ

# ========================================
# INSTRUCCIONES PARA CONFIGURAR GMAIL:
# ========================================
# 1. Activar verificación en 2 pasos en tu cuenta de Gmail
# 2. Ir a "Gestionar tu cuenta de Google" > Seguridad
# 3. En "Verificación en 2 pasos", buscar "Contraseñas de aplicaciones"
# 4. Generar una contraseña de aplicación para "Correo"
# 5. Usar esa contraseña (16 caracteres) en EMAIL_PASSWORD
# 6. EMAIL_USERNAME y FROM_EMAIL deben ser el mismo correo para Gmail
