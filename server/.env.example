# Base de datos MySQL (Core)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kmp_db
DB_USER=your_username
DB_PASSWORD=your_password

# Base de datos MySQL (Document Management)
DOCUMENT_DB_HOST=localhost
DOCUMENT_DB_PORT=3306
DOCUMENT_DB_NAME=documentos_db
DOCUMENT_DB_USER=your_username
DOCUMENT_DB_PASSWORD=your_password

#Server
SERVER_PORT=8080

# Google OAuth
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret

##solo usar localhost si se usa desktop en la misma maquina, android si o si usa un url publico
#EJEMPLOS
OAUTH_REDIRECT_URI=http://proyectron.duckdns.org:8080/auth/callback
#OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback

# CONFIGURACIÓN PARA EMAIL
EMAIL_ENABLED=true
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME=Sistema ERP BYJ

